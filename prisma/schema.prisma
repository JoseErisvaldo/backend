generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum SubscriptionTier {
  BASIC
  SIMPLE
  PRO
}

enum SubscriptionRecurrence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
  subscriptions Subscription[]

  @@map("users")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("BRL") @db.VarChar(3)
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paymentItems PaymentItem[]

  @@index([active])
  @@map("products")
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  externalReference String   @unique
  idempotencyKey    String?  @unique
  providerOrderId   String?  @unique
  amount            Decimal  @db.Decimal(10, 2)
  paymentMethod     String   @default("card")
  status            String   @default("created")
  statusDetail      String?
  providerResponse  Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             PaymentItem[]

  @@index([userId, createdAt])
  @@map("payments")
}

model PaymentItem {
  id          String   @id @default(uuid())
  paymentId   String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  currency    String   @db.VarChar(3)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([paymentId, productId])
  @@index([productId])
  @@map("payment_items")
}

model SubscriptionPlan {
  id              String                 @id @default(uuid())
  tier            SubscriptionTier
  recurrence      SubscriptionRecurrence
  amount          Decimal                @db.Decimal(10, 2)
  currency        String                 @default("BRL") @db.VarChar(3)
  active          Boolean                @default(true)
  providerPlanId  String?                @unique
  checkoutUrl     String?                @db.Text
  providerResponse Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  subscriptions   Subscription[]

  @@unique([tier, recurrence])
  @@index([active, tier])
  @@map("subscription_plans")
}

model Subscription {
  id                    String             @id @default(uuid())
  userId                String
  planId                String
  planTier              SubscriptionTier
  planRecurrence        SubscriptionRecurrence
  planAmount            Decimal            @db.Decimal(10, 2)
  planCurrency          String             @default("BRL") @db.VarChar(3)
  externalReference     String             @unique
  providerSubscriptionId String?            @unique
  payerEmail            String
  status                String             @default("pending")
  nextPaymentDate       DateTime?
  providerResponse      Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges               SubscriptionCharge[]

  @@index([userId, createdAt])
  @@index([planId, status])
  @@map("subscriptions")
}

model SubscriptionCharge {
  id                  String       @id @default(uuid())
  subscriptionId     String
  providerPaymentId  String       @unique
  amount              Decimal?     @db.Decimal(10, 2)
  currency            String?      @db.VarChar(3)
  status              String
  statusDetail        String?
  paidAt              DateTime?
  providerResponse    Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_charges")
}
